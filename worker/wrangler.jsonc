{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queria-company-resolver",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "account_id": "57c6a116efc637fc3f21d0affea15508",
  // company-resolver.queria.io で出す。workers.dev は計測用に残す
  "workers_dev": true,
  "routes": [{ "pattern": "company-resolver.queria.io", "custom_domain": true }],
  // 正引きの索引。scripts/sync_d1.py が models/forward/ の表を入れる
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "company-resolver-d1-test",
      "database_id": "01959e19-3242-4374-8f44-a273e4b18c14",
    },
  ],
  // 逆引きの索引 (Parquet) の置き場
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "queria" }],
  "vars": {
    // 逆引きの索引の置き場。Queria の company_resolver データセット (FDL のリポジトリ) のプレフィックス。
    // refs/heads/main が指すバージョンを読む (src/source.ts)
    "DATA_SOURCE": "903e9c75-6563-45c6-a3dd-0accc63e4d45/",
  },
  // IP ごとの回数の上限 (src/index.ts)。費用を守るためのもので、ふつうの使い方では当たらない高さ
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "3001", "simple": { "limit": 300, "period": 60 } },
    // /v1/forward/batch の回数 (1 回に 20 件まで)。D1 が断らないよう、件数で 1 分 200 件までに抑える
    { "name": "BATCH_LIMITER", "namespace_id": "3002", "simple": { "limit": 10, "period": 60 } },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
