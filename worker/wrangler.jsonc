{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queria-company-resolver",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "account_id": "57c6a116efc637fc3f21d0affea15508",
  // company-resolver.queria.io で出す。workers.dev は計測用に残す
  "workers_dev": true,
  "routes": [{ "pattern": "company-resolver.queria.io", "custom_domain": true }],
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "queria" }],
  "vars": {
    // 索引の置き場 (export_parquet.py の出力を置いたプレフィックス)
    "INDEX_PREFIX": "company-resolver/",
  },
  // IP ごとの回数の上限 (src/index.ts)。費用を守るためのもので、ふつうの使い方では当たらない高さ
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "3001", "simple": { "limit": 300, "period": 60 } },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
