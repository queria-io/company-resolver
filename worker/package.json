{
  "name": "company-resolver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "pnpm build:data",
    "build:data": "node scripts/build-data.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
