  "dependencies": {
    "fzstd": "^0.1.1",
    "hono": "^4.13.14",
    "hyparquet": "^1.32.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@duckdb/node-api": "2.0.0-r.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@10.17.1"
}
